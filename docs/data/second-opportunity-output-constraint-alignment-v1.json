  "CLASSIFICATION_POLICY": {
    "object_required": {
      "class": "MUST_BE_EXPLICIT_IN_PROMPT",
      "rationale": "omitting a field fails validation, so the block states how many fields there are and that every one is required"
    },
    "object_closed": {
      "class": "MUST_BE_EXPLICIT_IN_PROMPT",
      "rationale": "a field outside the contract fails validation, so the block says no other field is allowed"
    },
    "type": {
      "class": "PROVIDED_BY_TOOL_SCHEMA_AND_NOT_USEFUL_AS_PROSE",
      "rationale": "the tool schema carries every field's JSON type, and the rendered wording (characters, elements, exactly one of) already presupposes it"
    },
    "closed_choice": {
      "class": "MUST_BE_EXPLICIT_IN_PROMPT",
      "rationale": "a closed choice whose selection carries meaning; the exact members are rendered"
    },
    "composed_length": {
      "class": "MUST_BE_EXPLICIT_IN_PROMPT",
      "rationale": "the model composes this text and has to control its length while writing it"
    },
    "copied_length": {
      "class": "INTERNAL_VALIDATOR_ONLY",
      "rationale": "the value is copied verbatim from what the packet supplies, so generation never chooses its length; the bound serves the capacity walker and the validator"
    },
    "identity_grammar": {
      "class": "PROVIDED_BY_TOOL_SCHEMA_AND_NOT_USEFUL_AS_PROSE",
      "rationale": "regex syntax is not useful prose: the block says which supplied values to copy verbatim, and the tool schema carries their canonical form"
    },
    "annotation": {
      "class": "INTERNAL_VALIDATOR_ONLY",
      "rationale": "an annotation the local validator does not assert; the pattern beside it does the work"
    },
    "sentinel": {
      "class": "MUST_BE_EXPLICIT_IN_PROMPT",
      "rationale": "the schema's own description names an exact string the answer must use when the field has no supported value; that is refusal behaviour, and it is rendered verbatim"
    },
    "chosen_cardinality": {
      "class": "MUST_BE_EXPLICIT_IN_PROMPT",
      "rationale": "the model chooses how many elements to write and can naturally write too many"
    },
    "vocabulary_cardinality": {
      "class": "SEMANTICALLY_REDUNDANT_WITH_EXISTING_INSTRUCTION",
      "rationale": "the items are drawn from a closed vocabulary no larger than this bound, and the vocabulary is rendered, so no duplicate-free answer can exceed it"
    }
  },
