# Strict, reproducible installs for a long-lived monorepo.

# Do not silently hoist transitive dependencies into the root node_modules.
# A package must declare what it imports.
shamefully-hoist=false
hoist=false

# Fail the install if a workspace declares a dependency that is not satisfiable.
strict-peer-dependencies=false

# Prefer workspace packages over the registry when versions match.
link-workspace-packages=true
prefer-workspace-packages=true

# CI reproducibility: refuse to modify the lockfile when running with --frozen-lockfile.
resolution-mode=highest
auto-install-peers=true

# Node version enforcement comes from package.json#engines.
engine-strict=true
