# Normalize line endings. The repository stores LF; Windows checkouts are handled
# by core.autocrlf / the .editorconfig rules above.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or they will not execute.
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Shell scripts must keep LF even on Windows.
*.sh     text eol=lf
*.bash   text eol=lf

# Explicit text types.
*.ts     text
*.tsx    text
*.js     text
*.jsx    text
*.json   text
*.jsonc  text
*.md     text
*.mdx    text
*.py     text
*.pyi    text
*.sql    text
*.yml    text
*.yaml   text
*.toml   text
*.css    text
*.html   text
Dockerfile      text
*.dockerfile    text
.editorconfig   text
.gitattributes  text
.gitignore      text

# Binary — never diff, never normalize.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.pdf    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.zip    binary
*.gz     binary
*.parquet binary
*.onnx   binary
*.safetensors binary
*.bin    binary

# Lockfiles: keep in the repo, but do not show them in diffs or count them in
# language statistics. They are generated, reviewed by tooling, not by humans.
pnpm-lock.yaml   -diff linguist-generated=true
poetry.lock      -diff linguist-generated=true
uv.lock          -diff linguist-generated=true
package-lock.json -diff linguist-generated=true

# Generated contract artifacts (see packages/contracts) are reviewed via their
# source schema, not via the generated output.
**/generated/**  -diff linguist-generated=true

# Documentation counts as production code (PROJECT_MANIFEST.md §Repository
# Philosophy) — do NOT mark docs as linguist-documentation.
