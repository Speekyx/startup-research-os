# Local development environment template.
#
# Copy to `.env` in this directory and adjust. `.env` is git-ignored.
# NEVER put a real secret in this file -- it is committed.
#
#   cp infrastructure/compose/.env.example infrastructure/compose/.env

# NOTE: hosts are 127.0.0.1, never `localhost`. On Windows `localhost` resolves
# to ::1 first; Docker publishes these ports on IPv4 only, so every connection
# pays a ~15s IPv6 timeout before falling back. Measured in Mission 0.3:
# 0.01s via 127.0.0.1 vs 15.05s via localhost.

# --- PostgreSQL (system of record, ADR-008) ---------------------------------
POSTGRES_USER=sros
POSTGRES_PASSWORD=sros_dev_password
POSTGRES_DB=sros
POSTGRES_PORT=55432
# Non-default host port so the stack does not fight a locally installed Postgres.
DATABASE_URL=postgresql://sros:sros_dev_password@127.0.0.1:55432/sros

# --- Redis (Celery broker + cache, ADR-004) ---------------------------------
REDIS_PORT=55379
REDIS_URL=redis://127.0.0.1:55379/0
CELERY_BROKER_URL=redis://127.0.0.1:55379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:55379/1

# --- Qdrant (derived vector index, ADR-008) ---------------------------------
QDRANT_HTTP_PORT=55333
QDRANT_URL=http://127.0.0.1:55333

# --- LLM Gateway (ADR-006) ---------------------------------------------------
# Business services request a logical TIER, never a provider or model name.
# Model identifiers live here because models change faster than release cycles.
LLM_TIER_FAST_PROVIDER=null
LLM_TIER_FAST_MODEL=
LLM_TIER_BALANCED_PROVIDER=null
LLM_TIER_BALANCED_MODEL=
LLM_TIER_STRONG_PROVIDER=null
LLM_TIER_STRONG_MODEL=
LLM_TIER_EMBEDDING_PROVIDER=local
LLM_TIER_EMBEDDING_MODEL=bge-m3

# Provider credentials. Leave empty locally: no real provider call is made in
# Mission 0.2. Never commit a populated value.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Provider pricing is versioned CONFIGURATION, never a constant in code
# (Mission 0.4 §15). Empty means UNPRICED, which is not the same as free: an
# unpriced call records cost 0 because nothing is known, and the usage record
# says so. Set both together or neither.
#   LLM_PRICING_JSON={"anthropic:<model>":{"input_per_1k":0,"output_per_1k":0}}
LLM_PRICING_VERSION=
LLM_PRICING_JSON=

# Real-provider smoke tests are OPT-IN and disabled by default (§20). Both this
# flag AND a credential AND a model name are required before a paid call is
# made. A key exported for other work is not consent to spend money on a test
# run.
SROS_ENABLE_PROVIDER_SMOKE_TESTS=0
SROS_SMOKE_ANTHROPIC_MODEL=
SROS_SMOKE_GEMINI_MODEL=

# --- Budgets (ADR-006) -------------------------------------------------------
# Provider-agnostic cost units, not currency: no product pricing is invented.
# Exhaustion means COMPLETED with reduced Research Completeness, never FAILED.
BUDGET_MAX_COST_UNITS_PER_SESSION=100
BUDGET_MAX_LLM_CALLS_PER_SESSION=500
BUDGET_MAX_COST_UNITS_PER_WORKSPACE_DAY=1000

# --- Row-level security (ADR-012) -------------------------------------------
# The role assumed per transaction so PostgreSQL RLS actually applies. Created
# by migration 0003. Blanking it disables the second isolation layer and is
# refused outside development.
APP_DB_ROLE=sros_app

# --- Development workspace (ADR-005) ----------------------------------------
# A convenience for local development, NEVER a code path. No service may fall
# back to this when workspace_id is missing.
DEV_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
DEV_WORKSPACE_SLUG=dev
DEV_USER_ID=00000000-0000-4000-8000-000000000002
DEV_USER_EMAIL=dev@localhost

# --- Source credentials (Mission 1.4) ----------------------------------------
# KEY NAMES only, and left EMPTY here. The Source Registry stores the name of a
# configuration key; the value belongs in a real environment or a secret manager
# and never in a committed file. `sros-source verify` answers CONFIGURED /
# NOT_CONFIGURED from presence alone and never reads the value.
#
# `sros-source` reads the sibling `.env` (git-ignored) into its own process, so
# putting a real value THERE is enough -- no export needed. An explicitly
# exported variable still wins over the file.
#
# Leaving this blank is the normal state, and it is the state CI runs in: no
# .env exists there, so FRED stays collector-ineligible. That is correct, and it
# is the distinction the two gates exist to hold -- the compliance capabilities
# FRED's approval requires exist whether or not a credential does.
FRED_API_KEY=

# --- Observability -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
SERVICE_NAME=sros-local
ENVIRONMENT=development

# The assessed use profile this runtime operates under (Mission 1.15.5,
# ADR-027). REQUIRED for acquisition authorization, and never inferred: the
# same binary in the same container can legitimately be operated under either
# profile, so only a person knows which.
#
#   local-private-research-v1             this machine, one operator, no
#                                         redistribution, no customer access
#   commercial-multi-tenant-research-v1   a public, customer-facing deployment
#
# There is deliberately NO default. Local is not non-commercial: a
# commercial-use right still has to be granted by the source's own evidence.
SROS_USE_PROFILE=local-private-research-v1
