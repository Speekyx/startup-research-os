        "canonical_json": "{\"audience\":null,\"desired_mvp_complexity\":null,\"domains\":[\"gaming\"],\"excluded_categories\":[],\"excluded_markets\":[],\"filters\":{},\"languages\":[\"en\",\"fr\"],\"market_scope\":{\"countries\":[\"FR\",\"US\"],\"type\":\"MULTI_COUNTRY\"},\"market_types\":[],\"product_types\":[{\"id\":\"game\",\"registry\":\"product_type\"}],\"research_depth\":null,\"schema_version\":\"1.0.0\",\"technical_constraints\":[],\"time_horizon_days\":null}"
      }
