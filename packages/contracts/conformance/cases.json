  "forbidden_fields": {
    "$comment": "The D-03 guard, updated by Mission 1.1. D-03 is resolved at the framework level, so the guard no longer means 'nothing about aggregation'. It now distinguishes the designs V1 REJECTED, which stay forbidden everywhere, from the vocabulary V1 AUTHORISED, which is allowed only in the reference package and never in a production surface. Weakening this to 'anything scoring-related is fine' would give back exactly what D-03 protected.",
    "names": [
      "decay_weight",
      "aggregated_evidence_score",
      "independence_threshold_result",
      "contradiction_penalty",
      "evidence_aggregate"
    ],
    "rejected_designs": {
      "$comment": "Permanently forbidden in every surface. Each name encodes a design the framework considered and rejected with a stated reason, so its reappearance is a regression rather than an unblocked feature.",
      "decay_weight": "A per-item decay multiplier. V1 derives freshness from a profile half-life and folds it into q via min(); a separate weight would be a second, unversioned decay parameter (framework §9).",
      "contradiction_penalty": "A flat penalty such as 'score -= 20 if contradicted'. V1 makes contradiction continuous through contradiction_strength, so a weak and a strong contradiction differ (framework §8).",
      "aggregated_evidence_score": "An opaque aggregate with no decomposition. V1 requires the four masses to be published beside any score (framework §8).",
      "independence_threshold_result": "A boolean independence threshold. V1 uses provenance grouping and group counts, which a threshold cannot express (framework §7, resolving A-04).",
      "evidence_aggregate": "An unnamed catch-all. Every quantity V1 produces has a specific name and a stated meaning."
    },
    "authorised_v1_vocabulary": {
      "$comment": "Split in Mission 1.2. The single list conflated two different things, and only one of them stayed forbidden. INPUT fields describe an evidence record and are now legitimate schema columns (migration 0005, resolving A-13 and I-1). COMPUTED fields are aggregation RESULTS, and persisting one would be scoring -- which is still gated on a CALIBRATED profile that does not exist. This narrows the guard precisely; it does not weaken it.",
      "evidence_inputs": {
        "$comment": "Authorised in migrations, repositories and the API since Mission 1.2. They record WHAT WAS OBSERVED about an evidence record. Recording them is not aggregating them.",
        "names": [
          "independence_state",
          "independence_group_id",
          "observation_category",
          "extraction_confidence",
          "directness"
        ]
      },
      "computed_outputs": {
        "$comment": "Aggregation results. Allowed in the reference package and the canonical contracts, forbidden in migrations and under services/. A column holding one of these would mean scoring had started without a calibrated profile (evidence-aggregation-framework-v1.md §14).",
        "names": [
          "support_strength",
          "contradiction_strength",
          "supported_mass",
          "contradicted_mass",
          "conflict_mass",
          "uncertainty_mass",
          "evidence_score",
          "aggregation_profile_id",
          "algorithm_version"
        ]
      }
    },
    "universal_half_life": {
      "$comment": "framework §9: a half-life belongs to a versioned profile keyed by claim feature, never to a module-level constant. A constant named like these would be the universal half-life the framework refuses to invent, and it would work -- which is what makes it dangerous.",
      "forbidden_constant_names": [
        "DEFAULT_HALF_LIFE",
        "HALF_LIFE_DAYS",
        "EVIDENCE_HALF_LIFE",
        "DECAY_HALF_LIFE",
        "UNIVERSAL_HALF_LIFE"
      ]
    }
  },
