      { "case": { "registry": "product_type", "id": "SaaS" }, "reason": "registry ids are lowercase stable slugs, not display names" },
      { "case": { "registry": "product_type", "id": "" }, "reason": "empty id" },
      { "case": { "registry": "not_a_registry", "id": "x" }, "reason": "unknown registry" }
    ]
  },

