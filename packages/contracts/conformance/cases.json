      { "name": "invalid nested scope", "input": { "market_scope": { "type": "COUNTRY", "countries": [] } }, "reason": "nested MarketScope validation applies" },
      { "name": "unknown field", "input": { "market_scope": { "type": "GLOBAL" }, "not_a_field": 1 }, "reason": "unknown fields are rejected so a typo is not silently dropped" },
      { "name": "negative horizon", "input": { "market_scope": { "type": "GLOBAL" }, "time_horizon_days": -1 }, "reason": "time horizon must be positive" }
    ]
