{
  "name": "startup-research-os",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-driven AI Opportunity Research Engine \u2014 monorepo root",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "tsc --noEmit -p packages/contracts/tsconfig.json",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "clean": "turbo run clean && rimraf node_modules",
    "contracts:generate": "python packages/contracts/tools/generate.py",
    "contracts:check": "python packages/contracts/tools/generate.py --check",
    "db:validate": "python infrastructure/scripts/validate_schema.py",
    "py:test": "python -m unittest discover -s packages/contracts/python -p \"test_*.py\"",
    "test:ts": "node --test --experimental-strip-types packages/contracts/test/conformance.test.ts",
    "test:web": "node --test --experimental-strip-types apps/web/test/api-client.test.ts",
    "test:py": "python infrastructure/scripts/run_pytest_suites.py",
    "test:py:nodeps": "python infrastructure/scripts/run_python_tests.py"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^26.4.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  },
  "type": "module"
}
